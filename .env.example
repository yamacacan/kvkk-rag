# .env.example -> kopyalayip .env yapin. .env asla commit edilmez (.gitignore'da).

# Hangi LLM saglayicisi kullanilacak: gemini | anthropic | ollama
KVKK_LLM_PROVIDER=gemini

# API anahtarlari (yalnizca kullandiginiz saglayici icin gerekli)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model adlari
KVKK_GEMINI_MODEL=gemini-3.5-flash-lite
KVKK_ANTHROPIC_MODEL=claude-sonnet-5
KVKK_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Embedding modeli (deney kazanani, bkz docs/experiments/)
KVKK_EMBED_MODEL=intfloat/multilingual-e5-base
