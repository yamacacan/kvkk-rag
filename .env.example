# .env.example -> kopyalayip .env yapin. .env asla commit edilmez (.gitignore'da).

# Hangi LLM saglayicisi kullanilacak: gemini | anthropic | ollama
KVKK_LLM_PROVIDER=gemini

# API anahtarlari (yalnizca kullandiginiz saglayici icin gerekli)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model adlari
KVKK_GEMINI_MODEL=gemini-3.5-flash-lite
KVKK_ANTHROPIC_MODEL=claude-sonnet-5
KVKK_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Embedding modeli (deney kazanani, bkz docs/experiments/)
KVKK_EMBED_MODEL=intfloat/multilingual-e5-base

# --- API kimlik / yetki (RBAC) ---
# Ilk calistirmada hic kullanici yoksa bu bilgilerle Superadmin olusturulur.
# Sifre bos birakilirsa rastgele uretilir ve API logunda bir kez gosterilir.
KVKK_ADMIN_EMAIL=admin@kvkk.local
KVKK_ADMIN_PASSWORD=
# JWT: `python -m kvkk_rag.api.app.Console jwt:secret` ile uretin. Bos birakilirsa
# ilk calistirmada uretilip veritabanina (app_keys) yazilir.
KVKK_JWT_SECRET=
KVKK_JWT_TTL_MINUTES=60        # access jetonu omru
KVKK_REFRESH_TTL_HOURS=168     # refresh jetonu omru (7 gun)
# Arayuzun adresi: sifre sifirlama baglantilari buraya isaret eder (ayri deploy'da
# frontend origin'i) ve CORS'ta izinli olmali.
KVKK_APP_URL=http://localhost:8000
KVKK_APP_ENV=local             # local | production (local: reset linki yanitta doner)
# E-posta: log (gunluge yaz) | smtp
KVKK_MAIL_DRIVER=log
KVKK_MAIL_HOST=
KVKK_MAIL_PORT=587
KVKK_MAIL_USERNAME=
KVKK_MAIL_PASSWORD=
KVKK_MAIL_ENCRYPTION=tls       # tls | ssl | none
KVKK_MAIL_FROM_ADDRESS=kvkk@localhost
KVKK_MAIL_FROM_NAME=KVKK Uyum
KVKK_PASSWORD_RESET_TTL_MINUTES=60
# Yetki/kapsam onbellegi: bos -> surec ici bellek; coklu worker icin Redis
# (redis paketi gerekir): redis://redis:6379/0
KVKK_REDIS_URL=
# Onbellek TTL (saniye) ve izin verilen CORS kokenleri (virgulle)
KVKK_PERMISSION_CACHE_TTL=3600
KVKK_CORS_ORIGINS=*

# Kuyruk (belge üretimi gibi arka plan işleri). Varsayılan: API süreci içinde worker thread'i.
# 0 yapılırsa işler yalnızca ayrı worker ile işlenir: python -m kvkk_rag.api.app.Console queue:work
KVKK_QUEUE_WORKER=1
